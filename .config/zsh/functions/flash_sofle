#!/usr/bin/env zsh
# vim: ft=zsh

flash_sofle() {
  local km="${1:-hp_km}"
  local extra_arg="$2"

  # Backward compatibility: if someone calls `flash_sofle left` or `flash_sofle hp_km left`
  if [[ "$km" == "left" || "$km" == "right" ]]; then
    echo "ℹ️  Unified firmware builds a single binary for both halves. Using keymap: hp_km"
    km="hp_km"
  elif [[ -n "$extra_arg" ]]; then
    echo "ℹ️  Unified firmware builds a single binary for both halves. Side argument '$extra_arg' is no longer needed."
  fi

  echo "🔑 Pre-authenticating sudo for mounting the drive..."
  sudo -v
  if [[ $? -ne 0 ]]; then
    echo "❌ Sudo authentication failed. Exiting."
    return 1
  fi
  echo ""

  local qmk_home=""
  if command -v qmk >/dev/null 2>&1; then
    while IFS= read -r line; do
      if [[ "$line" == QMK_HOME=* || "$line" == QMK_FIRMWARE=* ]]; then
        echo "$line"
      fi
      if [[ "$line" == QMK_HOME=* ]]; then
        qmk_home="${line#QMK_HOME=}"
        qmk_home="${qmk_home#\"}"
        qmk_home="${qmk_home%\"}"
      fi
    done < <(qmk env 2>/dev/null)
  fi

  if [[ -z "$qmk_home" ]]; then
    qmk_home="/home/hope/full_vial_qmk_hope"
  fi

  _cleanup_uf2() {
    echo ""
    echo "🧹 Cleaning up old .uf2 files in $qmk_home..."
    if [[ -d "$qmk_home" ]]; then
      local latest_unified
      latest_unified=$(find "$qmk_home" -maxdepth 1 -name "sofle_rev1_${km}_*.uf2" -type f -printf "%T@ %p\n" 2>/dev/null | sort -nr | head -n 1 | cut -d" " -f2-)

      local unified_total=0 unified_deleted=0
      local other_total=0 other_deleted=0

      local f fname
      while IFS= read -r f; do
        [[ -z "$f" ]] && continue
        fname="${f:t}"
        if [[ "$fname" == sofle_rev1_${km}_[0-9]*_kb2040.uf2 ]]; then
          (( unified_total++ ))
          if [[ "$f" != "$latest_unified" ]]; then
            rm -f "$f" && (( unified_deleted++ ))
          fi
        elif [[ "$fname" == *[Ll][Ee][Ff][Tt]*.uf2 || "$fname" == *[Rr][Ii][Gg][Hh][Tt]*.uf2 ]]; then
          (( other_total++ ))
          rm -f "$f" && (( other_deleted++ ))
        fi
      done < <(find "$qmk_home" -maxdepth 1 -name "*.uf2" -type f 2>/dev/null)

      echo "   • Unified firmware: $unified_total present ($unified_deleted deleted, $(( unified_total - unified_deleted )) kept)"
      if (( other_total > 0 )); then
        echo "   • Legacy side files: $other_total deleted"
      fi
    fi
  }

  local comp_time
  comp_time=$(date +"%Y%m%d_%H%M%S")
  local final_target_file="sofle_rev1_${km}_${comp_time}"

  echo ""
  echo "🚀 Starting compilation for unified firmware (Sofle Rev1 / $km)..."
  echo ""

  local compile_start compile_end compile_diff
  compile_start=$(date +%s)
  qmk compile -kb sofle/rev1 -km "$km" -e CONVERT_TO=kb2040
  local qmk_status=$?
  compile_end=$(date +%s)
  compile_diff=$(( compile_end - compile_start ))

  if [[ $qmk_status -ne 0 ]]; then
    echo ""
    echo "❌ Error: QMK compilation failed."
    return 1
  fi

  echo ""
  local raw_uf2_file="$qmk_home/.build/sofle_rev1_${km}_kb2040.uf2"
  local uf2_file="$qmk_home/${final_target_file}_kb2040.uf2"

  if [[ -f "$raw_uf2_file" ]]; then
    echo "🏷️  Renaming compiled firmware with timestamp..."
    echo "    From: $(basename "$raw_uf2_file")"
    echo "    To:   $(basename "$uf2_file")"
    cp "$raw_uf2_file" "$uf2_file"

    local file_date file_size_bytes file_size_kb file_size_mb
    file_date=$(date -r "$uf2_file" +"%Y-%m-%d %H:%M:%S")
    file_size_bytes=$(stat -c%s "$uf2_file")
    file_size_kb=$(printf "%.1f" $(( file_size_bytes / 1024.0 )))
    file_size_mb=$(printf "%.2f" $(( file_size_bytes / 1048576.0 )))
  else
    echo "❌ Error: Firmware file $raw_uf2_file not found after compilation!"
    return 1
  fi

  echo ""
  echo "⏱️  Compile time: $compile_diff seconds"
  echo "📄 Firmware file: $uf2_file"
  echo "📅 Last modified: $file_date"
  echo "📦 Size: $file_size_kb KB ($file_size_mb MB)"
  echo ""
  echo "========================================="
  echo "       UNIFIED SOFLE FIRMWARE            "
  echo "  (Flash this same file to BOTH halves)  "
  echo "========================================="
  echo ""

  local flashed_halves=0

  _flash_drive() {
    local retry_count=0
    local prompt_msg="$1"

    echo "$prompt_msg"
    echo ""

    while true; do
      local detected=0
      if [[ ! -d /mnt/e ]]; then
        sudo mkdir -p /mnt/e
      fi

      # Attempt mount using drvfs if not mounted
      if ! mountpoint -q /mnt/e; then
        sudo mount -t drvfs E: /mnt/e 2>/dev/null
      fi

      if mountpoint -q /mnt/e; then
        # Check if it's the RP2040 bootloader
        if [[ -f /mnt/e/INFO_UF2.TXT ]] || ls /mnt/e 2>/dev/null | grep -q -i "INFO_UF2"; then
          detected=1
        else
          sudo umount /mnt/e 2>/dev/null || true
        fi
      fi

      # Fallback check using cmd.exe if interop path is available
      if [[ $detected -eq 0 ]] && command -v cmd.exe >/dev/null 2>&1; then
        if cmd.exe /c "vol E:" 2>/dev/null | grep -q "RPI-RP2"; then
          if ! mountpoint -q /mnt/e; then
            sudo mount -t drvfs E: /mnt/e 2>/dev/null
          fi
          if mountpoint -q /mnt/e; then
            detected=1
          fi
        fi
      fi

      if [[ $detected -eq 1 ]]; then
        echo ""
        echo "🚀 Copying $uf2_file to /mnt/e/ ..."
        cp "$uf2_file" /mnt/e/

        echo "🧹 Unmounting drive..."
        sleep 1
        sudo umount /mnt/e 2>/dev/null || true

        (( flashed_halves++ ))
        echo "🎉 Done! Half #$flashed_halves has rebooted with new firmware."
        return 0
      else
        retry_count=$(( retry_count + 1 ))
        local check_again="c"
        local user_input=""
        for i in {3..1}; do
          printf "\r❌ [Retry %d] Not found on E:. ⏳ Waiting for bootloader drive (Enter=retry, Q=skip/quit)\e[K" "$retry_count"
          if read -k 1 -t 1 -r user_input 2>/dev/null; then
            if [[ "$user_input" =~ ^[qQ]$ ]]; then
              check_again="q"
            fi
            break
          fi
        done

        if [[ "$check_again" == "q" ]]; then
          echo ""
          return 1
        fi
      fi
    done
  }

  # First half
  if _flash_drive "👉 Put your FIRST half into bootloader mode (double-tap reset)..."; then
    echo ""
    echo "--------------------------------------------------------"
    echo "💡 Would you like to flash the SECOND half now? (Y/n)"
    echo "   (Double-tap reset on the other half, or press Q/n to finish)"
    echo "--------------------------------------------------------"

    local next_input=""
    read -k 1 -r next_input
    echo ""
    if [[ ! "$next_input" =~ ^[nNqQ]$ ]]; then
      _flash_drive "👉 Put your SECOND half into bootloader mode (double-tap reset)..."
    fi
  fi

  echo ""
  if (( flashed_halves > 0 )); then
    echo "✨ All done! Flashed $flashed_halves half/halves with $uf2_file."
  else
    echo "ℹ️  No halves were flashed."
  fi

  _cleanup_uf2
}

flash_sofle "$@"
